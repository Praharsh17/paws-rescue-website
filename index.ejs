<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <title>Home | Paws and Hearts Rescue</title>
  <link rel="stylesheet" href="/style.css">
  <style>
    /* UPDATED TO EARTHY THEME COLORS */
    :root { 
      --primary: #7E8A6A; /* Sage Green */
      --accent: #D08C60;  /* Terracotta */
      --bg: #F9F6F0;      /* Soft Oat */
      --text: #2A201A;    /* Espresso */
    }
    body { font-family: 'Segoe UI', Tahoma, sans-serif; margin: 0; background-color: var(--bg); color: var(--text); }
    nav { background: white; padding: 20px 50px; display: flex; justify-content: space-between; border-bottom: 2px solid #E6E1D6; }
    nav a { text-decoration: none; color: var(--text); font-weight: bold; margin-left: 20px; }
    nav a:hover { color: var(--primary); }
    
    .hero { text-align: center; padding: 100px 20px; background-color: white; margin-top: 40px; border-bottom: 1px solid #E6E1D6; }
    .hero h1 { color: var(--primary); font-size: 3rem; margin-top: 0; margin-bottom: 20px; }
    .hero p { font-size: 1.2rem; color: #5E4A3B; max-width: 600px; margin: 0 auto 40px auto; line-height: 1.6; }
    
    .btn { background-color: var(--accent); color: white; padding: 15px 30px; text-decoration: none; border-radius: 8px; font-weight: bold; font-size: 1.1rem; transition: 0.3s; margin: 10px; display: inline-block; }
    .btn-outline { background-color: white; color: var(--accent); border: 2px solid var(--accent); }
    .btn:hover { background-color: #B36A4C; }
    .btn-outline:hover { background-color: var(--accent); color: white; }
  </style>
</head>
<body>
  <nav>
    <div style="font-size: 1.2rem; font-weight: bold; color: var(--primary);">🐾 Paws & Hearts Rescue</div>
    <div>
      <a href="/">Home</a>
      <a href="/animals">Meet the Animals</a>
      <a href="/contact">Adopt</a>
      <a href="/surrender">Give for Adoption</a>
    </div>
  </nav>

  <div class="hero">
    <h1>Welcome to Paws & Hearts Rescue</h1>
    <p>We are dedicated to rescuing, rehabilitating, and finding loving homes for animals in need. Whether you are looking to adopt a new family member or need to safely surrender a pet, our NGO is here to help.</p>
    <div>
      <a href="/animals" class="btn">Meet Our Animals</a>
      <a href="/surrender" class="btn btn-outline">Surrender a Pet</a>
    </div>
  </div>
</body>
</html>